#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.120.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

reorder rootPrims = ["Root", "WaterMaterial"]

def Xform "Root"
{
    def "Message" (
        active = true
        references = @Message.usdz@
    )
    {
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Message" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            customData = {
                dictionary RE = {
                    dictionary mesh = {
                        dictionary v1 = {
                            bool reorderVertexCaching = 0
                        }
                    }
                }
            }
        )
        {
            reorder nameChildren = ["Material", "GroundingShadow", "Message_01"]
            rel material:binding = </Root/Message/Message/Message_01> (
                bindMaterialAs = "weakerThanDescendants"
            )

            over "Material"
            {
                reorder nameChildren = ["Heartbeat", "PreviewSurface", "UnlitSurface", "FrenselMask"]
                token outputs:mtlx:surface.connect = </Root/Message/Message/Material/PreviewSurface.outputs:out>
                float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (335.5, 100.5)
                int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 875

                over "PreviewSurface"
                {
                    float inputs:clearcoat
                    float inputs:clearcoatRoughness
                    color3f inputs:emissiveColor
                    float inputs:ior
                    float3 inputs:normal
                    float inputs:occlusion
                    float inputs:opacityThreshold
                    float2 ui:nodegraph:node:pos = (112.921875, 32.304688)
                    int ui:nodegraph:node:stackingOrder = 872
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
                }
            }

            def RealityKitComponent "GroundingShadow"
            {
                bool enableIBLShadow = 1
                bool enableMeshShadow = 1
                bool enableReceiveIBLShadow = 0
                bool enableReceiveMeshShadow = 0
                uniform token info:id = "RealityKit.GroundingShadow"
            }

            def Material "Message_01"
            {
                reorder nameChildren = ["PreviewSurface", "FrenselMask", "Heartbeat"]
                float inputs:FresnelPower = 3 (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (275.5, 488)
                            int stackingOrderInSubgraph = 1940
                        }
                    }
                )
                color3f inputs:GlowColor = (0.27679446, 0.6000156, 0.741804) (
                    colorSpace = "srgb_texture"
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (486, 27.5)
                            int stackingOrderInSubgraph = 1731
                        }
                    }
                )
                float inputs:GlowIntensity = 50 (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (275.5, 373)
                            int stackingOrderInSubgraph = 1940
                        }
                    }
                )
                float inputs:GlowOpacity = 0.3 (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (486, 142.5)
                            int stackingOrderInSubgraph = 1731
                        }
                    }
                )
                float inputs:TimeSpeed = 0.4 (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (69.5, 202.5)
                            int stackingOrderInSubgraph = 1940
                        }
                    }
                )
                token outputs:mtlx:surface.connect = </Root/Message/Message/Message_01/PreviewSurface.outputs:out>
                token outputs:realitykit:vertex
                float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (1189.5, 169.5)
                int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 1881

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                    color3f inputs:diffuseColor = (1, 1, 1) (
                        colorSpace = "srgb_texture"
                    )
                    color3f inputs:emissiveColor.connect = </Root/Message/Message/Message_01/Multiply_4.outputs:out>
                    float inputs:ior
                    float inputs:metallic
                    float3 inputs:normal
                    float inputs:opacity = 0.5
                    float inputs:roughness = 0.2
                    token outputs:out
                    float2 ui:nodegraph:node:pos = (947.5, 169.5)
                    int ui:nodegraph:node:stackingOrder = 1963
                    string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
                }

                def NodeGraph "FrenselMask"
                {
                    float inputs:FrenselPower (
                        customData = {
                            dictionary realitykit = {
                                float2 positionInSubgraph = (589, 178.5)
                                int stackingOrderInSubgraph = 857
                            }
                        }
                    )
                    float inputs:FrenselPower.connect = </Root/Message/Message/Message_01.inputs:FresnelPower>
                    float outputs:FresnelMask_out.connect = </Root/Message/Message/Message_01/FrenselMask/FresnelMask.outputs:out>
                    float2 ui:nodegraph:node:pos = (486, 460.5)
                    int ui:nodegraph:node:stackingOrder = 1940
                    float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (1037.8086, 77.71484)
                    int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 856

                    def Shader "ViewDirection"
                    {
                        uniform token info:id = "ND_realitykit_viewdirection_vector3"
                        float3 outputs:out
                        float2 ui:nodegraph:node:pos = (122.94141, 105.20703)
                        int ui:nodegraph:node:stackingOrder = 850
                    }

                    def Shader "Oneminus"
                    {
                        uniform token info:id = "ND_realitykit_oneminus_float"
                        float inputs:in.connect = </Root/Message/Message/Message_01/FrenselMask/DotProduct.outputs:out>
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (589, 57.5)
                        int ui:nodegraph:node:stackingOrder = 846
                    }

                    def Shader "Normal"
                    {
                        uniform token info:id = "ND_normal_vector3"
                        string inputs:space = "world"
                        float3 outputs:out
                        float2 ui:nodegraph:node:pos = (160.52734, 27.976562)
                        int ui:nodegraph:node:stackingOrder = 852
                        string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["outputs:out"]
                    }

                    def Shader "FresnelMask"
                    {
                        uniform token info:id = "ND_power_float"
                        float inputs:in1.connect = </Root/Message/Message/Message_01/FrenselMask/Oneminus.outputs:out>
                        float inputs:in2.connect = </Root/Message/Message/Message_01/FrenselMask.inputs:FrenselPower>
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (818.5, 81.5)
                        int ui:nodegraph:node:stackingOrder = 846
                    }

                    def Shader "DotProduct"
                    {
                        uniform token info:id = "ND_dotproduct_vector3"
                        float3 inputs:in1.connect = </Root/Message/Message/Message_01/FrenselMask/Normal.outputs:out>
                        float3 inputs:in2.connect = </Root/Message/Message/Message_01/FrenselMask/ViewDirection.outputs:out>
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (359.5, 57.5)
                        int ui:nodegraph:node:stackingOrder = 846
                    }
                }

                def NodeGraph "Heartbeat"
                {
                    float inputs:TimeSpeed (
                        customData = {
                            dictionary realitykit = {
                                float2 positionInSubgraph = (72, 142.5)
                                int stackingOrderInSubgraph = 878
                            }
                        }
                    )
                    float inputs:TimeSpeed.connect = </Root/Message/Message/Message_01.inputs:TimeSpeed>
                    float outputs:Add_out.connect = </Root/Message/Message/Message_01/Heartbeat/Add.outputs:out>
                    float2 ui:nodegraph:node:pos = (275.5, 202.5)
                    int ui:nodegraph:node:stackingOrder = 1940
                    float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (797, 57.5)

                    def Shader "Time"
                    {
                        uniform token info:id = "ND_time_float"
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (72, 27.5)
                        int ui:nodegraph:node:stackingOrder = 877
                    }

                    def Shader "Multiply"
                    {
                        uniform token info:id = "ND_multiply_float"
                        float inputs:in1.connect = </Root/Message/Message/Message_01/Heartbeat/Time.outputs:out>
                        float inputs:in2.connect = </Root/Message/Message/Message_01/Heartbeat.inputs:TimeSpeed>
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (232.5, 57.5)
                        int ui:nodegraph:node:stackingOrder = 877
                    }

                    def Shader "Add"
                    {
                        uniform token info:id = "ND_add_float"
                        float inputs:in1.connect = </Root/Message/Message/Message_01/Heartbeat/Multiply_1.outputs:out>
                        float inputs:in2 = 0.5
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (646.5, 57.5)
                        int ui:nodegraph:node:stackingOrder = 877
                    }

                    def Shader "Sin"
                    {
                        uniform token info:id = "ND_sin_float"
                        float inputs:in.connect = </Root/Message/Message/Message_01/Heartbeat/Multiply.outputs:out>
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (380.5, 57.5)
                        int ui:nodegraph:node:stackingOrder = 877
                    }

                    def Shader "Multiply_1"
                    {
                        uniform token info:id = "ND_multiply_float"
                        float inputs:in1.connect = </Root/Message/Message/Message_01/Heartbeat/Sin.outputs:out>
                        float inputs:in2 = 0.4
                        float outputs:out
                        float2 ui:nodegraph:node:pos = (528.5, 57.5)
                        int ui:nodegraph:node:stackingOrder = 877
                        string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:in2"]
                    }
                }

                def Shader "Multiply_4" (
                    references = None
                )
                {
                    uniform token info:id = "ND_multiply_color3FA"
                    color3f inputs:in1.connect = </Root/Message/Message/Message_01/Multiply.outputs:out>
                    float inputs:in2.connect = </Root/Message/Message/Message_01/Multiply_3.outputs:out>
                    color3f outputs:out
                    float2 ui:nodegraph:node:pos = (765.5, 169.5)
                    int ui:nodegraph:node:stackingOrder = 1731
                }

                def Shader "Multiply"
                {
                    uniform token info:id = "ND_multiply_color3FA"
                    color3f inputs:in1.connect = </Root/Message/Message/Message_01.inputs:GlowColor>
                    float inputs:in2.connect = </Root/Message/Message/Message_01.inputs:GlowOpacity>
                    color3f outputs:out
                    float2 ui:nodegraph:node:pos = (648.5, 57.5)
                    int ui:nodegraph:node:stackingOrder = 1731
                }

                def Shader "Multiply_2" (
                    references = None
                )
                {
                    uniform token info:id = "ND_multiply_float"
                    float inputs:in1.connect = </Root/Message/Message/Message_01.inputs:GlowIntensity>
                    float inputs:in2.connect = </Root/Message/Message/Message_01/Heartbeat.outputs:Add_out>
                    float outputs:out
                    float2 ui:nodegraph:node:pos = (486, 248)
                    int ui:nodegraph:node:stackingOrder = 1940
                }

                def Shader "Multiply_3" (
                    references = None
                )
                {
                    uniform token info:id = "ND_multiply_float"
                    float inputs:in1.connect = </Root/Message/Message/Message_01/Multiply_2.outputs:out>
                    float inputs:in2.connect = </Root/Message/Message/Message_01/FrenselMask.outputs:FresnelMask_out>
                    float outputs:out
                    float2 ui:nodegraph:node:pos = (648.5, 317.5)
                    int ui:nodegraph:node:stackingOrder = 1940
                }
            }
        }
    }
}

