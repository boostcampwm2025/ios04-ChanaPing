            }

            over "GroundMATSG" (
                active = false
            )
            {
                string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:file4:varname"]

                over "UnlitSurface"
                {
                    float inputs:opacityThreshold
