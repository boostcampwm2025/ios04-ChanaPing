#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.120.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

reorder rootPrims = ["Root", "WaterMaterial"]

def Xform "Root"
{
    def "Dome" (
        active = true
        references = @Dome.usdz@
